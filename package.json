{
  "name": "medical-terminology-explorer",
  "version": "1.2.0",
  "description": "Explorer for the HKU Medical Terminology list. Fetches and Base64-decodes live data (no local copy).",
  "main": "electron.js",
  "scripts": {
    "version:sync": "node scripts/sync-version.js",
    "prestart": "npm run version:sync",
    "version": "node scripts/sync-version.js --git-add",
    "start": "node server.js",
    "desktop": "electron .",
    "dist": "npm run version:sync && electron-builder --publish never",
    "cap:add:android": "npx cap add android && npm run version:sync",
    "cap:add:ios": "npx cap add ios && npm run version:sync",
    "cap:sync": "npm run version:sync && npx cap sync",
    "cap:open:android": "npx cap open android",
    "cap:open:ios": "npx cap open ios"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.0",
    "@capacitor/cli": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/android": "^6.0.0",
    "@capacitor/ios": "^6.0.0"
  },
  "build": {
    "appId": "com.rcky844.medicalexplorer",
    "productName": "Medical Terminology Explorer",
    "directories": {
      "output": "dist"
    },
    "files": [
      "public/**/*",
      "server.js",
      "electron.js",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    },
    "artifactName": "mt-explorer_v${version}.${ext}"
  },
  "dependencies": {
    "@capacitor/filesystem": "^6.0.0",
    "@capacitor/share": "^6.0.0"
  }
}
