{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Medical Terminology Explorer",
  "version": "1.0.0",
  "identifier": "com.rcky844.medicalexplorer",
  "build": {
    "frontendDist": "../public",
    "beforeDevCommand": "npm run start",
    "devUrl": "http://localhost:3000"
  },
  "app": {
    "windows": [
      {
        "title": "Medical Terminology Explorer",
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ]
  }
}
